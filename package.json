{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -b",
    "test": "playwright test tests/acceptance.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "screenshot": "playwright test tests/screenshot.spec.ts",
    "playwright:install": "playwright install chromium",
    "test:auth": "playwright test tests/auth.spec.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:all": "playwright test tests/acceptance.spec.ts tests/auth.spec.ts tests/regression.spec.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "^1.170.36",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.14",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
